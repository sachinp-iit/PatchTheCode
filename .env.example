# PatchTheCode environment configuration.
# Copy to `.env` and fill in values for your deployment.
# Never commit real secrets.

# --- LLM Gateway (LiteLLM routing) ---
# Any LiteLLM-compatible provider/model string is supported.
# PATCHTHECODE_MODEL_INVESTIGATION=openrouter/anthropic/claude-sonnet
# PATCHTHECODE_MODEL_CODEGEN=anthropic/claude-sonnet
# PATCHTHECODE_MODEL_VALIDATION=openai/gpt-4o-mini
PATCHTHECODE_MODEL_DEFAULT=openrouter/anthropic/claude-sonnet
PATCHTHECODE_LLM_TIMEOUT_SECONDS=120

# LiteLLM requires provider API keys, e.g.:
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- MCP Connections ---
# Config in JSON. See docs/ARCHITECTURE.md for the schema.
# PATCHTHECODE_MCP_CONFIG=config/mcp.json

# --- Storage ---
PATCHTHECODE_STORE_PATH=data/patchthecode.db

# --- Notifications ---
# PATCHTHECODE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PATCHTHECODE_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# --- Safety ---
# Comma-separated globs of log fields to treat as sensitive.
PATCHTHECODE_REDACT_FIELDS=Authorization,Cookie,password,secret,token,api_key
# Set to true to let the agent open pull requests without asking. Off by
# default: write actions are logged and blocked pending human approval.
# PATCHTHECODE_AUTO_PR=true